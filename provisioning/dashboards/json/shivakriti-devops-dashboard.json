        "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(shivakriti_http_request_duration_seconds_bucket[1m])))", "legendFormat": "p95 Latency", "refId": "A" },
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(shivakriti_http_request_duration_seconds_bucket[1m])))", "legendFormat": "p50 Latency (Median)", "refId": "B" }
      ],
      "title": "HTTP Response Latency (p95 & p50)",
      "type": "timeseries"
    },
